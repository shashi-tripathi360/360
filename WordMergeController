public with sharing class WordMergeController {
    @AuraEnabled
    public static Map<String, Object> getRecordFields(Id recordId) {
        // Fetch some fields from Contact (expand as needed)
        Contact c = [
            SELECT Id, FirstName, LastName, Email 
            FROM Contact 
            WHERE Id = :recordId LIMIT 1
        ];

        Map<String, Object> fields = new Map<String, Object>();
        fields.put('FirstName', c.FirstName);
        fields.put('LastName', c.LastName);
        fields.put('Email', c.Email);

        return fields;
    }
}
